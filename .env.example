# ============================================================================
# Bitso Twitter API - Environment Variables
# ============================================================================

# ----------------------------------------------------------------------------
# NextAuth Configuration
# ----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# ----------------------------------------------------------------------------
# Redis Database (Upstash)
# ----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://tidy-fish-21136.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ----------------------------------------------------------------------------
# Encryption Key (for storing bot tokens)
# ----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-here

# ----------------------------------------------------------------------------
# Twitter OAuth 2.0 (Admin Login)
# ----------------------------------------------------------------------------
# Used for NextAuth Twitter provider
# Shared from goodboy project
X_API_CLIENT_ID=your-twitter-oauth2-client-id
X_API_CLIENT_SECRET=your-twitter-oauth2-client-secret

# ----------------------------------------------------------------------------
# Twitter OAuth 1.0a (Bot Connection)
# ----------------------------------------------------------------------------
# Used for bot authentication and webhook management
# Shared from goodboy project
TWITTER_OAUTH_API_KEY=your-twitter-oauth1-api-key
TWITTER_OAUTH_API_SECRET=your-twitter-oauth1-api-secret

# ----------------------------------------------------------------------------
# Twitter API v2 (Webhooks & Bearer Token)
# ----------------------------------------------------------------------------
# Used for webhook registration
# Shared from goodboy project
X_API_BEARER_TOKEN=your-twitter-bearer-token

# ----------------------------------------------------------------------------
# Admin Users (Whitelist)
# ----------------------------------------------------------------------------
# Comma-separated list of Twitter usernames (without @) allowed to login
ALLOWED_ADMIN_USERS=gotoalberto,bitsoonchain

# ----------------------------------------------------------------------------
# Bot Configuration
# ----------------------------------------------------------------------------
# Twitter handle of the bot account (without @)
BOT_TWITTER_HANDLE=your-bot-handle

# Webhook environment name
TWITTER_WEBHOOK_ENV=production

# ----------------------------------------------------------------------------
# Public App URL
# ----------------------------------------------------------------------------
# Used for OAuth callbacks and webhook registration
# Development: http://localhost:3000
# Production: https://bitso-twitter-api.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# Notes:
# ============================================================================
# 1. Copy this file to .env.local for development
# 2. Never commit .env.local or any file with real credentials
# 3. Tokens are encrypted before storing in Redis using ENCRYPTION_KEY
# 4. All Twitter credentials are shared from the goodboy project
# 5. Admin users whitelist controls who can access the dashboard
# ============================================================================
