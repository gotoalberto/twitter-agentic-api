generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// TwitterApp stores the Twitter API credentials for a specific application
/// Multiple projects can share the same Twitter App credentials
model TwitterApp {
  id             String          @id @default(cuid())
  name           String          @unique

  // OAuth 1.0a credentials (optional - needed for webhook subscriptions with projects)
  consumerKey    String?         // Now optional - only needed for projects/webhooks
  consumerSecret String?         // Now optional - only needed for projects/webhooks

  // OAuth 2.0 credentials (optional - for user authentication)
  clientId       String?         // OAuth 2.0 Client ID
  clientSecret   String?         // OAuth 2.0 Client Secret

  // Bearer Token for App-Only auth (OAuth 2.0)
  bearerToken    String

  webhookEnv     String          @default("production")

  // Webhook configuration (one webhook per app)
  webhookId         String?      // X webhook ID
  webhookUrl        String?      // Full webhook URL for this app
  webhookValid      Boolean      @default(false)
  webhookCreatedAt  DateTime?    // When webhook was registered in X

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  projects       Project[]
  hivemindConfig HivemindConfig?

  @@map("twitter_apps")
}

/// Project represents an external application that uses the X Forwarder
/// to publish tweets and receive webhooks
model Project {
  id                   String                @id @default(cuid())
  name                 String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  apiKey               String?
  apiEnabled           Boolean               @default(true)
  twitterAppId         String?
  bot                  Bot?
  forwardingConfig     ForwardingConfig?
  forwardingEndpoints  ForwardingEndpoint[]
  idempotentTweets     IdempotentTweet[]
  receivedTweets       ReceivedTweet[]
  rateLimits           RateLimit[]
  twitterApp           TwitterApp?           @relation(fields: [twitterAppId], references: [id])
  webhookDeliveries    WebhookDelivery[]
  webhookLogs          WebhookLog[]
  webhookRegistrations WebhookRegistration[]

  @@index([twitterAppId])
  @@map("projects")
}

/// Bot represents a Twitter/X bot account connected to a project
/// Supports both OAuth 1.0a and OAuth 2.0 credentials during migration
model Bot {
  id                String   @id @default(cuid())
  projectId         String   @unique
  username          String   @unique
  userId            String   @unique

  // OAuth 1.0a credentials (to be removed after migration)
  accessToken       String
  accessTokenSecret String

  // OAuth 2.0 credentials (new)
  oauth2AccessToken String?  // OAuth 2.0 access token
  refreshToken      String?  // OAuth 2.0 refresh token (with offline.access scope)
  expiresAt         DateTime? // Token expiration timestamp
  scope             String?  // OAuth 2.0 scopes granted

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([username])
  @@map("bots")
}

/// ForwardingConfig defines where to forward webhook events for a project
model ForwardingConfig {
  id        String   @id @default(cuid())
  projectId String   @unique
  endpoint  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("forwarding_configs")
}

/// WebhookRegistration tracks Twitter webhook subscriptions for each project
model WebhookRegistration {
  id         String   @id @default(cuid())
  projectId  String
  webhookId  String   @unique
  url        String
  subscribed Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([webhookId])
  @@map("webhook_registrations")
}

/// WebhookLog stores ALL webhook events with a queue system for reliable delivery
/// Implements infinite retries with FIFO ordering
model WebhookLog {
  id            String    @id @default(cuid())
  projectId     String
  eventType     String
  forwardedTo   String
  status        String    @default("pending")
  statusCode    Int?
  payload       Json
  createdAt     DateTime  @default(now())
  attempts      Int       @default(0)
  deliveredAt   DateTime?
  errorMessage  String?
  lastAttemptAt DateTime?
  nextRetryAt   DateTime?
  responseBody  Json?
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status, nextRetryAt])
  @@map("webhook_logs")
}

/// ForwardingEndpoint defines webhook forwarding endpoints for a project
/// A project can have multiple endpoints (primary, backup, analytics, etc.)
/// Replaces the 1:1 ForwardingConfig with 1:N relationship
model ForwardingEndpoint {
  id         String            @id @default(cuid())
  projectId  String
  name       String
  url        String
  enabled    Boolean           @default(true)
  priority   Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([projectId])
  @@index([projectId, enabled])
  @@index([projectId, priority])
  @@map("forwarding_endpoints")
}

/// WebhookDelivery tracks delivery of webhooks to specific endpoints
/// Replaces WebhookLog with endpoint-specific tracking
/// Supports "paused" status for disabled endpoints
model WebhookDelivery {
  id            String             @id @default(cuid())
  projectId     String
  endpointId    String
  eventType     String
  payload       Json
  status        String             @default("pending")
  statusCode    Int?
  attempts      Int                @default(0)
  lastAttemptAt DateTime?
  nextRetryAt   DateTime?
  deliveredAt   DateTime?
  errorMessage  String?
  responseBody  Json?
  createdAt     DateTime           @default(now())
  endpoint      ForwardingEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status, nextRetryAt])
  @@index([endpointId, status])
  @@index([endpointId, status, nextRetryAt])
  @@map("webhook_deliveries")
}

/// IdempotentTweet stores tweet publishing requests with idempotency keys
/// Prevents duplicate tweets from being published when clients retry requests
/// Cache expires after 24 hours
model IdempotentTweet {
  id             String   @id @default(cuid())
  projectId      String   @map("project_id")
  idempotencyKey String   @map("idempotency_key")
  tweetId        String   @map("tweet_id")
  tweetText      String   @map("tweet_text")
  replyToTweetId String?  @map("reply_to_tweet_id")
  publishedAt    DateTime @default(now()) @map("published_at")
  expiresAt      DateTime @map("expires_at")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, idempotencyKey])
  @@index([projectId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotent_tweets")
}

/// HivemindConfig stores the configuration for the Hivemind feature
/// Defines which TwitterApp is offered to Hivemind users
model HivemindConfig {
  id           String      @id @default(cuid())
  twitterAppId String?     @unique
  enabled      Boolean     @default(false)
  apiKey       String?     @map("api_key") // API key for external apps to tweet via Hivemind users
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  twitterApp   TwitterApp? @relation(fields: [twitterAppId], references: [id])

  @@map("hivemind_config")
}

/// HivemindUser stores Twitter users who have connected to the Hivemind
/// These are regular users (not bots) who authorize the app for tweet/DM access
/// No webhooks are registered for these users
model HivemindUser {
  id                String   @id @default(cuid())
  userId            String   @unique @map("user_id")
  username          String   @unique
  displayName       String   @map("display_name")
  profileImageUrl   String?  @map("profile_image_url")

  // OAuth 1.0a credentials (to be removed after migration)
  accessToken       String   @map("access_token")
  accessTokenSecret String   @map("access_token_secret")

  // OAuth 2.0 credentials (new)
  oauth2AccessToken String?  @map("oauth2_access_token") // OAuth 2.0 access token
  refreshToken      String?  @map("refresh_token")       // OAuth 2.0 refresh token
  expiresAt         DateTime? @map("expires_at")         // Token expiration timestamp
  scope             String?  @map("scope")               // OAuth 2.0 scopes granted

  connectedAt       DateTime @default(now()) @map("connected_at")
  lastActiveAt      DateTime @default(now()) @map("last_active_at")
  isActive          Boolean  @default(true) @map("is_active")

  // Relations
  rateLimits        RateLimit[]

  @@index([username])
  @@index([isActive])
  @@index([connectedAt])
  @@map("hivemind_users")
}

/// ReceivedTweet stores tweets received via webhook for a project
/// Allows projects to query their tweet history via API
model ReceivedTweet {
  id                String   @id @default(cuid())
  projectId         String   @map("project_id")

  // Twitter identifiers
  tweetId           String   @map("tweet_id")          // Twitter's tweet ID
  userId            String   @map("user_id")           // ID of the user who posted the tweet
  username          String                              // Username of the poster
  userDisplayName   String?  @map("user_display_name") // Display name of the poster

  // Tweet content
  text              String                              // Full text of the tweet
  truncated         Boolean  @default(false)           // Whether the tweet was truncated

  // Reply information
  inReplyToStatusId String?  @map("in_reply_to_status_id") // If this is a reply, the tweet it's replying to
  inReplyToUserId   String?  @map("in_reply_to_user_id")   // If this is a reply, the user it's replying to

  // Bot information
  forUserId         String   @map("for_user_id")       // The bot user ID that received this tweet

  // Metadata
  lang              String?                            // Language of the tweet
  retweetCount      Int      @default(0) @map("retweet_count")
  favoriteCount     Int      @default(0) @map("favorite_count")
  replyCount        Int      @default(0) @map("reply_count")
  quoteCount        Int      @default(0) @map("quote_count")

  // Media and entities (stored as JSON)
  entities          Json?                              // Hashtags, mentions, URLs, etc.
  extendedEntities  Json?    @map("extended_entities") // Media attachments

  // Full raw payload for reference
  rawPayload        Json     @map("raw_payload")       // Complete webhook payload

  // Timestamps
  tweetCreatedAt    DateTime @map("tweet_created_at")  // When the tweet was posted on Twitter
  receivedAt        DateTime @default(now()) @map("received_at") // When we received the webhook

  // Relations
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, tweetId]) // Prevent duplicate tweets per project
  @@index([projectId, receivedAt(sort: Desc)]) // For querying latest tweets
  @@index([projectId, forUserId]) // For filtering by bot
  @@index([projectId, userId]) // For filtering by sender
  @@index([tweetId]) // For looking up specific tweets
  @@map("received_tweets")
}

/// RateLimit stores the current rate limit status for each endpoint and account
model RateLimit {
  id              String   @id @default(cuid())

  // Owner identification (either project or hivemind)
  projectId       String?  @map("project_id")       // For project bots
  hivemindUserId  String?  @map("hivemind_user_id") // For Hivemind users

  // Account that made the request
  accountId       String   @map("account_id")       // Twitter user ID
  accountUsername String   @map("account_username") // Twitter username

  // Endpoint information
  endpoint        String                            // e.g., "POST /2/tweets", "POST /2/users/:id/likes"
  endpointType    String   @map("endpoint_type")    // e.g., "tweet", "like", "retweet", "search", "timeline"

  // Rate limit values
  limit           Int                               // Total requests allowed in window
  remaining       Int                               // Requests remaining
  reset           DateTime                          // When the rate limit resets

  // Tracking
  lastUpdated     DateTime @default(now()) @map("last_updated") // Last time this was updated
  lastRequestAt   DateTime @default(now()) @map("last_request_at") // Last API call timestamp

  // Relations
  project         Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  hivemindUser    HivemindUser? @relation(fields: [hivemindUserId], references: [userId], onDelete: Cascade)

  // Unique constraint: one rate limit per endpoint per account
  @@unique([accountId, endpoint])
  @@index([projectId, endpoint])
  @@index([hivemindUserId, endpoint])
  @@index([reset]) // For finding expired rate limits
  @@index([endpointType, accountId])
  @@map("rate_limits")
}
