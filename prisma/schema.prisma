// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MODELS
// ============================================================================

/// Project represents an external application that uses the X Forwarder
/// to publish tweets and receive webhooks
model Project {
  id        String   @id @default(cuid())
  name      String   @unique
  apiKey    String?  // API key for authenticating tweet publishing requests
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bot                   Bot?
  forwardingConfig      ForwardingConfig?
  webhookRegistrations  WebhookRegistration[]
  webhookLogs           WebhookLog[]
  idempotentTweets      IdempotentTweet[]

  @@map("projects")
}

/// Bot represents a Twitter/X bot account connected to a project
/// Uses OAuth 1.0a credentials for tweet publishing and webhook management
model Bot {
  id                String   @id @default(cuid())
  projectId         String   @unique
  username          String   @unique
  userId            String   @unique
  accessToken       String   // OAuth 1.0a access token
  accessTokenSecret String   // OAuth 1.0a access token secret
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("bots")
  @@index([projectId])
  @@index([username])
}

/// ForwardingConfig defines where to forward webhook events for a project
model ForwardingConfig {
  id        String   @id @default(cuid())
  projectId String   @unique
  endpoint  String   // URL to forward webhooks to (e.g., https://goodboy.xyz/api/webhooks/twitter)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("forwarding_configs")
  @@index([projectId])
}

/// WebhookRegistration tracks Twitter webhook subscriptions for each project
model WebhookRegistration {
  id         String   @id @default(cuid())
  projectId  String
  webhookId  String   @unique // Twitter webhook ID
  url        String   // Twitter webhook URL (registered with Twitter)
  subscribed Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("webhook_registrations")
  @@index([projectId])
  @@index([webhookId])
}

/// WebhookLog stores ALL webhook events with a queue system for reliable delivery
/// Implements infinite retries with FIFO ordering
model WebhookLog {
  id             String    @id @default(cuid())
  projectId      String
  eventType      String    // tweet_create_events, direct_message_events, etc.
  forwardedTo    String    // URL where the webhook was forwarded
  status         String    @default("pending") // "pending" | "processing" | "delivered" | "failed"
  statusCode     Int?      // HTTP status code from forwarding response
  payload        Json      // Full webhook payload from Twitter
  attempts       Int       @default(0) // Number of delivery attempts
  lastAttemptAt  DateTime? // Timestamp of last delivery attempt
  nextRetryAt    DateTime? // Timestamp for next retry (null for pending, set after failure)
  deliveredAt    DateTime? // Timestamp of successful delivery
  errorMessage   String?   // Last error message if delivery failed
  responseBody   Json?     // Response body from the forwarding endpoint
  createdAt      DateTime  @default(now())

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("webhook_logs")
  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status, nextRetryAt])
}

/// IdempotentTweet stores tweet publishing requests with idempotency keys
/// Prevents duplicate tweets from being published when clients retry requests
/// Cache expires after 24 hours
model IdempotentTweet {
  id               String   @id @default(cuid())
  projectId        String   // Project that published the tweet
  idempotencyKey   String   // Client-provided unique key (e.g., PendingReply.id)
  tweetId          String   // Twitter tweet ID from successful publish
  tweetText        String   // Tweet text (for debugging)
  replyToTweetId   String?  // Original tweet ID if this is a reply
  publishedAt      DateTime @default(now())
  expiresAt        DateTime // Automatic cleanup after 24 hours

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, idempotencyKey])
  @@map("idempotent_tweets")
  @@index([projectId, idempotencyKey])
  @@index([expiresAt]) // For cleanup job
}
