#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Security: LOW-005 - Git hook for secret detection
# Prevents committing sensitive information like API keys, private keys, etc.

echo "🔒 Running secret detection..."

# Patterns to detect (case-insensitive)
PATTERNS=(
  # Private Keys
  "BEGIN RSA PRIVATE KEY"
  "BEGIN PRIVATE KEY"
  "BEGIN OPENSSH PRIVATE KEY"
  "BEGIN EC PRIVATE KEY"
  "BEGIN DSA PRIVATE KEY"
  "BEGIN PGP PRIVATE KEY"

  # AWS Credentials
  "AKIA[0-9A-Z]{16}"
  "ASIA[0-9A-Z]{16}"
  "aws_access_key_id"
  "aws_secret_access_key"

  # Stripe
  "sk_live_[0-9a-zA-Z]{24,}"
  "pk_live_[0-9a-zA-Z]{24,}"
  "sk_test_[0-9a-zA-Z]{24,}"
  "rk_live_[0-9a-zA-Z]{24,}"

  # GitHub
  "ghp_[0-9a-zA-Z]{36}"
  "gho_[0-9a-zA-Z]{36}"
  "ghu_[0-9a-zA-Z]{36}"
  "ghs_[0-9a-zA-Z]{36}"
  "ghr_[0-9a-zA-Z]{36}"

  # OpenAI
  "sk-proj-[a-zA-Z0-9_-]{43,}"

  # Generic patterns
  "api[_-]?key['\"]?\s*[:=]\s*['\"][^'\"]{20,}"
  "secret[_-]?key['\"]?\s*[:=]\s*['\"][^'\"]{20,}"
  "password['\"]?\s*[:=]\s*['\"][^'\"]{8,}"
  "bearer\s+[a-zA-Z0-9_\-\.=]{20,}"
  "token['\"]?\s*[:=]\s*['\"][^'\"]{20,}"

  # Ethereum/Crypto Private Keys
  "0x[a-fA-F0-9]{64}"
  "private_key.*0x[a-fA-F0-9]{64}"

  # Database URLs with credentials
  "postgres://[a-zA-Z0-9_]+:[^@]+@"
  "mysql://[a-zA-Z0-9_]+:[^@]+@"
  "mongodb://[a-zA-Z0-9_]+:[^@]+@"

  # JWT Tokens (long base64 strings)
  "eyJ[a-zA-Z0-9_-]{30,}\.[a-zA-Z0-9_-]{30,}"
)

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  echo "✅ No files staged for commit"
  exit 0
fi

# Check for secrets in staged files
FOUND_SECRETS=false

for FILE in $STAGED_FILES; do
  # Skip binary files, specific directories, and allowed files
  if [[ "$FILE" == *".lock" ]] || \
     [[ "$FILE" == "package-lock.json" ]] || \
     [[ "$FILE" == *"node_modules"* ]] || \
     [[ "$FILE" == *".next"* ]] || \
     [[ "$FILE" == *"dist/"* ]] || \
     [[ "$FILE" == *"build/"* ]] || \
     [[ "$FILE" == *".git/"* ]] || \
     [[ "$FILE" == ".husky/pre-commit" ]] || \
     [[ "$FILE" == ".env.example" ]] || \
     [[ "$FILE" == ".env.local.example" ]] || \
     [[ "$FILE" == *".example" ]] || \
     [[ "$FILE" == ".gitleaks.toml" ]] || \
     [[ "$FILE" == "SECURITY.md" ]] || \
     [[ "$FILE" == "SECURITY_IMPLEMENTATION_SUMMARY.md" ]] || \
     [[ "$FILE" == *".github/workflows/"* ]]; then
    continue
  fi

  # Block any .env file that's not an example
  if [[ "$FILE" == .env* ]] && [[ "$FILE" != *.example ]]; then
    echo "❌ BLOCKED: Attempting to commit sensitive .env file: $FILE"
    echo "   .env files should NEVER be committed!"
    echo "   Use .env.example for templates instead."
    FOUND_SECRETS=true
    continue
  fi

  # Check if file exists (it might have been deleted)
  if [ ! -f "$FILE" ]; then
    continue
  fi

  # Check each pattern
  for PATTERN in "${PATTERNS[@]}"; do
    if grep -iE "$PATTERN" "$FILE" > /dev/null 2>&1; then
      echo "❌ Potential secret found in: $FILE"
      echo "   Pattern: $PATTERN"
      FOUND_SECRETS=true
    fi
  done
done

if [ "$FOUND_SECRETS" = true ]; then
  echo ""
  echo "❌ COMMIT BLOCKED: Potential secrets detected!"
  echo "   Please review the files above and remove any sensitive data."
  echo "   If this is a false positive, you can:"
  echo "   - Use environment variables instead of hardcoded values"
  echo "   - Add the pattern to .gitignore"
  echo "   - Skip this hook with: git commit --no-verify (NOT RECOMMENDED)"
  echo ""
  exit 1
fi

echo "✅ No secrets detected"
