generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// TwitterApp stores the Twitter API credentials for a specific application
/// Multiple projects can share the same Twitter App credentials
model TwitterApp {
  id               String          @id @default(cuid())
  name             String          @unique
  consumerKey      String?
  consumerSecret   String?
  bearerToken      String
  webhookEnv       String          @default("production")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  clientId         String?
  clientSecret     String?
  webhookCreatedAt DateTime?
  webhookId        String?
  webhookUrl       String?
  webhookValid     Boolean         @default(false)
  hivemindConfig   HivemindConfig?
  projects         Project[]

  @@map("twitter_apps")
}

/// Project represents an external application that uses the X Forwarder
/// to publish tweets and receive webhooks
model Project {
  id                   String                @id @default(cuid())
  name                 String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  apiKey               String?
  apiEnabled           Boolean               @default(true)
  twitterAppId         String?
  bot                  Bot?
  forwardingConfig     ForwardingConfig?
  forwardingEndpoints  ForwardingEndpoint[]
  idempotentTweets     IdempotentTweet[]
  twitterApp           TwitterApp?           @relation(fields: [twitterAppId], references: [id])
  rateLimits           RateLimit[]
  receivedTweets       ReceivedTweet[]
  webhookDeliveries    WebhookDelivery[]
  webhookLogs          WebhookLog[]
  webhookRegistrations WebhookRegistration[]

  @@index([twitterAppId])
  @@map("projects")
}

/// Bot represents a Twitter/X bot account connected to a project
/// Supports both OAuth 1.0a and OAuth 2.0 credentials during migration
model Bot {
  id                String    @id @default(cuid())
  projectId         String    @unique
  username          String    @unique
  userId            String    @unique
  accessToken       String
  accessTokenSecret String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  oauth2AccessToken String?
  refreshToken      String?
  expiresAt         DateTime?
  scope             String?
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([username])
  @@map("bots")
}

/// ForwardingConfig defines where to forward webhook events for a project
model ForwardingConfig {
  id        String   @id @default(cuid())
  projectId String   @unique
  endpoint  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("forwarding_configs")
}

/// WebhookRegistration tracks Twitter webhook subscriptions for each project
model WebhookRegistration {
  id         String   @id @default(cuid())
  projectId  String
  webhookId  String   @unique
  url        String
  subscribed Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([webhookId])
  @@map("webhook_registrations")
}

/// WebhookLog stores ALL webhook events with a queue system for reliable delivery
/// Implements infinite retries with FIFO ordering
model WebhookLog {
  id            String    @id @default(cuid())
  projectId     String
  eventType     String
  forwardedTo   String
  status        String    @default("pending")
  statusCode    Int?
  payload       Json
  createdAt     DateTime  @default(now())
  attempts      Int       @default(0)
  deliveredAt   DateTime?
  errorMessage  String?
  lastAttemptAt DateTime?
  nextRetryAt   DateTime?
  responseBody  Json?
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status, nextRetryAt])
  @@map("webhook_logs")
}

/// ForwardingEndpoint defines webhook forwarding endpoints for a project
/// A project can have multiple endpoints (primary, backup, analytics, etc.)
/// Replaces the 1:1 ForwardingConfig with 1:N relationship
model ForwardingEndpoint {
  id         String            @id @default(cuid())
  projectId  String
  name       String
  url        String
  enabled    Boolean           @default(true)
  priority   Int               @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([projectId])
  @@index([projectId, enabled])
  @@index([projectId, priority])
  @@map("forwarding_endpoints")
}

/// WebhookDelivery tracks delivery of webhooks to specific endpoints
/// Replaces WebhookLog with endpoint-specific tracking
/// Supports "paused" status for disabled endpoints
model WebhookDelivery {
  id            String             @id @default(cuid())
  projectId     String
  endpointId    String
  eventType     String
  payload       Json
  status        String             @default("pending")
  statusCode    Int?
  attempts      Int                @default(0)
  lastAttemptAt DateTime?
  nextRetryAt   DateTime?
  deliveredAt   DateTime?
  errorMessage  String?
  responseBody  Json?
  createdAt     DateTime           @default(now())
  endpoint      ForwardingEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status, nextRetryAt])
  @@index([endpointId, status])
  @@index([endpointId, status, nextRetryAt])
  @@map("webhook_deliveries")
}

/// IdempotentTweet stores tweet publishing requests with idempotency keys
/// Prevents duplicate tweets from being published when clients retry requests
/// Cache expires after 24 hours
model IdempotentTweet {
  id             String   @id @default(cuid())
  projectId      String   @map("project_id")
  idempotencyKey String   @map("idempotency_key")
  tweetId        String   @map("tweet_id")
  tweetText      String   @map("tweet_text")
  replyToTweetId String?  @map("reply_to_tweet_id")
  publishedAt    DateTime @default(now()) @map("published_at")
  expiresAt      DateTime @map("expires_at")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, idempotencyKey])
  @@index([projectId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotent_tweets")
}

/// HivemindConfig stores the configuration for the Hivemind feature
/// Defines which TwitterApp is offered to Hivemind users
model HivemindConfig {
  id           String      @id @default(cuid())
  twitterAppId String?     @unique
  enabled      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  apiKey       String?     @map("api_key")
  twitterApp   TwitterApp? @relation(fields: [twitterAppId], references: [id])

  @@map("hivemind_config")
}

/// HivemindUser stores Twitter users who have connected to the Hivemind
/// These are regular users (not bots) who authorize the app for tweet/DM access
/// No webhooks are registered for these users
model HivemindUser {
  id                String      @id @default(cuid())
  userId            String      @unique @map("user_id")
  username          String      @unique
  displayName       String      @map("display_name")
  profileImageUrl   String?     @map("profile_image_url")
  accessToken       String      @map("access_token")
  accessTokenSecret String      @map("access_token_secret")
  connectedAt       DateTime    @default(now()) @map("connected_at")
  lastActiveAt      DateTime    @default(now()) @map("last_active_at")
  isActive          Boolean     @default(true) @map("is_active")
  oauth2AccessToken String?     @map("oauth2_access_token")
  refreshToken      String?     @map("refresh_token")
  expiresAt         DateTime?   @map("expires_at")
  scope             String?     @map("scope")
  rateLimits        RateLimit[]

  @@index([username])
  @@index([isActive])
  @@index([connectedAt])
  @@index([isActive], map: "idx_hivemind_users_is_active")
  @@index([username], map: "idx_hivemind_users_username")
  @@map("hivemind_users")
}

/// ReceivedTweet stores tweets received via webhook for a project
/// Allows projects to query their tweet history via API
model ReceivedTweet {
  id                String   @id @default(cuid())
  projectId         String   @map("project_id")
  tweetId           String   @map("tweet_id")
  userId            String   @map("user_id")
  username          String
  userDisplayName   String?  @map("user_display_name")
  text              String
  truncated         Boolean  @default(false)
  inReplyToStatusId String?  @map("in_reply_to_status_id")
  inReplyToUserId   String?  @map("in_reply_to_user_id")
  forUserId         String   @map("for_user_id")
  lang              String?
  retweetCount      Int      @default(0) @map("retweet_count")
  favoriteCount     Int      @default(0) @map("favorite_count")
  replyCount        Int      @default(0) @map("reply_count")
  quoteCount        Int      @default(0) @map("quote_count")
  entities          Json?
  extendedEntities  Json?    @map("extended_entities")
  rawPayload        Json     @map("raw_payload")
  tweetCreatedAt    DateTime @map("tweet_created_at")
  receivedAt        DateTime @default(now()) @map("received_at")
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, tweetId])
  @@index([projectId, receivedAt(sort: Desc)])
  @@index([projectId, forUserId])
  @@index([projectId, userId])
  @@index([tweetId])
  @@map("received_tweets")
}

/// RateLimit stores the current rate limit status for each endpoint and account
model RateLimit {
  id              String        @id @default(cuid())
  projectId       String?       @map("project_id")
  hivemindUserId  String?       @map("hivemind_user_id")
  accountId       String        @map("account_id")
  accountUsername String        @map("account_username")
  endpoint        String
  endpointType    String        @map("endpoint_type")
  limit           Int
  remaining       Int
  reset           DateTime
  lastUpdated     DateTime      @default(now()) @map("last_updated")
  lastRequestAt   DateTime      @default(now()) @map("last_request_at")
  hivemindUser    HivemindUser? @relation(fields: [hivemindUserId], references: [userId], onDelete: Cascade)
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([accountId, endpoint])
  @@index([projectId, endpoint])
  @@index([hivemindUserId, endpoint])
  @@index([reset])
  @@index([endpointType, accountId])
  @@map("rate_limits")
}
